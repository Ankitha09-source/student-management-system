```gitignore
# Maven
target/
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Application secrets and environment variables
.env
.env.*
!.env.example
application-local.properties
application-prod.properties
secrets.properties

# Logs
*.log
logs/

# Java
*.class

# Spring Tool Suite
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# IntelliJ IDEA
.idea
*.iws
*.iml
*.ipr

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# VS Code
.vscode/

# Operating system files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.swp

# Help file (optional)
HELP.md
```